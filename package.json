{
  "name": "virt-advisor",
  "version": "0.10.0",
  "private": true,
  "engines": {
    "node": "14.15.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=12288 nuxt",
    "dev:clean": "dev.bat",
    "go": ".\\go.bat",
    "serve": ".\\serve.bat",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=12288 nuxt start",
    "generate": "nuxt generate",
    "check:branch": "node scripts/check-branch-state.js --report",
    "check:engines": "node scripts/check-engines.js",
    "routing": "node scripts/generate-content-routing.js",
    "handbook": "node scripts/build-handbook.js",
    "to-do": "node scripts/apply-to-do.js",
    "feature": "node scripts/new-feature.js",
    "lint": "eslint --ext .js,.vue .",
    "lint:fix": "eslint --ext .js,.vue . --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "visual": "jest --config jest.visual.config.js",
    "visual:setup": "node node_modules/playwright/cli.js install chromium",
    "backend": "cross-env ALLOW_DEV_AUTH=true node server/restify-server.js",
    "dev:all": "concurrently --names \"nuxt,api\" --prefix-colors \"cyan,green\" \"npm run dev\" \"npm run backend\"",
    "serve:all": "concurrently --names \"web,api\" --prefix-colors \"cyan,green\" \"npm run start\" \"npm run backend\"",
    "debug:scoring": "node scripts/debug-scoring.js",
    "build:semantic-profiles": "node scripts/build-semantic-profiles.js",
    "audit:content": "node scripts/audit-content-coverage.js",
    "migrate:ghosts": "node scripts/migrate-ghost-references.js",
    "generate:signal-maps": "node scripts/generate-signal-maps.js",
    "generate:signal-assignments": "node scripts/generate-signal-assignments.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "buefy": "^0.9.29",
    "bulma": "^0.9.4",
    "dotenv": "8.6.0",
    "formidable": "2.1.2",
    "googleapis": "123.0.0",
    "graceful-fs": "^4.2.11",
    "isomorphic-dompurify": "1.3.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^13.0.2",
    "mysql2": "3.16.0",
    "nuxt": "2.14.0",
    "restify": "9.1.0",
    "vue": "^2.6.14",
    "vue-i18n": "^8.27.2",
    "vue-router": "^3.5.3",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "7.10.4",
    "@nuxtjs/eslint-config": "6.0.1",
    "@vue/test-utils": "1.3.6",
    "@vue/vue2-jest": "27.0.0",
    "babel-jest": "^27.5.1",
    "concurrently": "7.6.0",
    "cross-env": "7.0.3",
    "cssnano": "4.1.11",
    "eslint": "7.32.0",
    "husky": "^8.0.3",
    "jest": "^27.5.1",
    "playwright": "1.34.3",
    "pug": "^2.0.4",
    "pug-plain-loader": "^1.1.0",
    "vue-template-compiler": "2.7.16"
  },
  "overrides": {
    "shell-quote": "1.8.4",
    "@nuxt/friendly-errors-webpack-plugin": "2.5.2",
    "js-beautify": "1.14.0",
    "@nuxt/telemetry": {
      "consola": "2.15.3"
    },
    "node-releases": "2.0.14",
    "@types/node": "14.18.63"
  }
}
