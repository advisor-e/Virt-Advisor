{
  "name": "virt-advisor",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 NODE_EXTRA_CA_CERTS=./certs/digicert-bundle.pem nuxt",
    "dev:clean": "dev.bat",
    "serve": "serve.bat",
    "start": "cross-env NODE_EXTRA_CA_CERTS=./certs/digicert-bundle.pem nuxt start",
    "generate": "nuxt generate",
    "lint": "eslint --ext .js,.vue .",
    "lint:fix": "eslint --ext .js,.vue . --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "backend": "node server/restify-server.js",
    "debug:scoring": "node scripts/debug-scoring.js",
    "build:semantic-profiles": "node scripts/build-semantic-profiles.js",
    "audit:content": "node scripts/audit-content-coverage.js",
    "migrate:ghosts": "node scripts/migrate-ghost-references.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "buefy": "^0.9.29",
    "bulma": "^0.9.4",
    "formidable": "^3.5.4",
    "googleapis": "^144.0.0",
    "isomorphic-dompurify": "^3.9.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^13.0.2",
    "mysql2": "^3.22.3",
    "nuxt": "2.18.1",
    "openai": "^4.0.0",
    "restify": "^11.1.0",
    "vue": "^2.6.14",
    "vue-i18n": "^8.27.2",
    "vue-router": "^3.5.3",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.3",
    "@nuxtjs/eslint-config": "^12.0.0",
    "babel-jest": "^27.5.1",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.4",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "jest": "^27.5.1",
    "pug": "^2.0.4",
    "pug-plain-loader": "^1.1.0"
  }
}
