# =============================================================================
# Virt Advisor - environment template
# =============================================================================
#
# Copy this file to `.env` and fill in the values for your environment:
#
#     cp .env.example .env
#
# !! NEVER PUT A REAL VALUE IN THIS FILE. !!
# `.env` is gitignored; `.env.example` is COMMITTED. A secret typed here is in
# the repository's history permanently, and rotating the key is then the only
# remedy. Names and explanations only.
#
# Two things that are NOT obvious and have each cost someone a day:
#
#  1. The backend loads `.env` itself (server/restify-server.js), and dotenv
#     never overwrites a variable already present in the environment - so a
#     platform-injected value always wins over this file.
#
#  2. NODE_EXTRA_CA_CERTS is set PER MACHINE, in the real environment, not here.
#     See design/HANDOFF.md.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED - the app does not work correctly without these
# -----------------------------------------------------------------------------

# The OpenAI REST API key. Backend only - it must never appear in a Nuxt file.
# The backend logs `OPENAI_API_KEY present=true/false` at startup and treats a
# missing key as fatal. This is the variable most often forgotten, because it is
# absent from the integration table in design/HANDOFF.md.
OPENAI_API_KEY=

# The signing secret for the Advisor-e JWT, used to verify every request.
# Must match the Advisor-e auth service. In production the server REFUSES TO
# BOOT while this is unset or still the placeholder.
# If Advisor-e signs with RS256 rather than HS256, see HANDOFF.md step 5.
JWT_SECRET=

# MySQL connection. In production the server REFUSES TO BOOT while the password
# is unset or still `REPLACE_ME`.
# Run config/db-schema.sql against this database before first use, INCLUDING the
# reserved `firms` rows (`__platform__`, and one per management scope) - a save
# with no matching row is rejected by a foreign key.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# `production` in any deployed environment, INCLUDING UAT.
#
# 🔴 READ THIS BEFORE LEAVING IT UNSET. Outside production every store falls
# back to a local `data/dev-*.json` file when the database cannot be reached,
# and the screen reports success. A UAT sign-off can therefore be completed
# without a single row ever reaching MySQL. Setting `production` closes that,
# and additionally fails the boot fast on any placeholder above.
#
# The trade-off, which is real: `NODE_ENV=production` also forbids
# ALLOW_DEV_AUTH (see section 5), and the global-group and group manager hubs
# can ONLY be opened with a dev token today, because Advisor-e issues no role
# value for those two tiers yet. Production mode = honest storage but two hubs
# unreachable. Choose deliberately; do not drift into it.
NODE_ENV=production

# Where the browser reaches the Restify backend. The Nuxt frontend's ONLY
# legitimate environment variable. Empty = same origin via the built-in proxies,
# which is correct for a single-host deployment.
API_BASE_URL=


# -----------------------------------------------------------------------------
# 2. NETWORK - only needed if the server must answer other machines
# -----------------------------------------------------------------------------
# Every default here is loopback-only, so a fresh install talks to nobody but
# itself. That is deliberate: exposing the app to a network is always something
# somebody asked for.

# Frontend (Nuxt, default port 3000, default host ::1 - IPv6 loopback).
# Set HOST=0.0.0.0 to answer on every interface, or a specific address.
HOST=
PORT=

# Backend (Restify, default port 4000, default host 127.0.0.1 - IPv4 loopback).
# Only set BACKEND_HOST if the backend must be reached from another machine;
# a single-host deployment should leave it alone.
BACKEND_HOST=
BACKEND_PORT=

# Set to `true` only when running behind a reverse proxy or load balancer, so
# per-IP rate limiting reads the forwarded client address instead of the proxy's.
# Leave unset when the app is reached directly - trusting the header without a
# proxy in front lets a caller spoof their own IP and evade the rate limit.
TRUST_PROXY=


# -----------------------------------------------------------------------------
# 3. OPTIONAL INTEGRATIONS - the app runs without them, with that feature off
# -----------------------------------------------------------------------------

# Google Drive, used by the Firm Manager document library (upload/download of a
# firm's logic tables and domain-support PDFs). Without these, that tab cannot
# store files; nothing else is affected. Setup is HANDOFF.md step 3.
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_BASE_FOLDER_ID=

# Where a recommended template's page lives inside the master app, so a
# recommendation can deep-link to it. Defaults are the live Advisor-e addresses;
# set these only if the master app's page structure differs.
ADVISOR_E_DASHBOARD_URL=
ADVISOR_E_PAGE_BASE=

# Contact address sent with MyMemory translation requests, which raises that
# service's free daily quota. Unset simply means the lower anonymous quota.
MYMEMORY_EMAIL=


# -----------------------------------------------------------------------------
# 4. MACHINE-LEVEL - do not set here
# -----------------------------------------------------------------------------
# NODE_EXTRA_CA_CERTS belongs in the machine's own environment, not in this
# file. It is needed only where antivirus or a corporate proxy re-signs HTTPS;
# without it, every OpenAI call fails in about 20ms, which reads as a network
# outage rather than a certificate problem. It was hardcoded into the npm
# scripts once and OVERRODE correctly-configured machines - hence this note
# rather than a variable. Full diagnosis in design/HANDOFF.md.


# -----------------------------------------------------------------------------
# 5. DEV ONLY - MUST NOT be set in UAT or production
# -----------------------------------------------------------------------------

# Enables hard-coded bearer tokens (`dev-local-mentor`, `dev-local-global`,
# `dev-local-group`, `dev-local-bypass`) that bypass Advisor-e authentication
# entirely. It is the only way to open the two middle-tier hubs today, and it is
# refused outright in production - the server exits rather than boots. Never set
# it on any host reachable by anyone outside the team.
# ALLOW_DEV_AUTH=true

# Verbose advisor-engine logging, and strict content validation that throws on a
# malformed logic tree instead of skipping it. Development diagnostics only.
# VA_DEBUG=true
# VA_STRICT_CONTENT=true

# Relocate the dev-only JSON fallback stores. Only ever read outside production,
# and only when no database answers. Listed for completeness - a deployment
# should never need them, and needing one means MySQL is not connected.
# CLIENT_DEV_FILE=
# CASE_DEV_FILE=
# COURSE_DEV_FILE=
# FIRM_COACHING_DEV_FILE=
# FIRM_MEMBERSHIP_DEV_FILE=
# FIRMS_DEV_FILE=
# COLLAB_DEV_STORE_FILE=
