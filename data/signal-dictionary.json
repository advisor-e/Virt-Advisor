{
  "version": "1.4.0",
  "description": "Signal extraction dictionary — the single source of truth for what advisor phrases map to which signals. Edit this file to add or improve phrase coverage. No code changes required. Run npm run build:semantic-profiles after changes.",
  "signals": {
    "sales_volume": {
      "description": "Insufficient sales volume, customer acquisition, or foot traffic",
      "domains": ["sales-marketing", "profit"],
      "patterns": [
        "foot.?traffic",
        "not enough (customers?|clients?|people|visitors?)",
        "sales (are|is|were|was) (down|slow|low|poor|flat|weak)",
        "slow (sales|business|trade)",
        "(low|poor|bad|poor) conversion",
        "not (getting|converting|attracting) (enough )?(leads?|inquiries|customers?|business)",
        "lack of demand",
        "losing customers?",
        "customer numbers?",
        "need (more )?customers?",
        "grow(ing)? (the )?(customer|client) base",
        "attract (more )?(customers?|clients?|people)",
        "build (a )?(client|customer) base",
        "more (customers?|clients?|sales|business)",
        "not enough (foot|walk.in|walk in) traffic",
        "run(ning)? out of (customers?|clients?|people)",
        "not upselling",
        "upsell(ing)?.*not happening",
        "no upsell",
        "upsell(ing)?",
        "cross.?sell(ing)?",
        "sell(ing)? more",
        "increase (their )?(average )?(spend|transaction|basket|order value)",
        "sales (issue|problem|trouble|struggle|struggling)",
        "struggling (to|with) (sell|sales)",
        "(low|declining|dropping|falling) sales",
        "can'?t (win|land|close|get) (new )?(clients?|customers?|work|business)",
        "few (prospects?|leads?|enquiries|inquiries)"
      ]
    },
    "pricing_issue": {
      "description": "Pricing problems, price rises, or margin pressure due to pricing",
      "domains": ["profit", "sales-marketing"],
      "patterns": [
        "put(ting)?.{0,15}price[s]? up",
        "price[s]? (rise|increase|hike|going up)",
        "pricing (issue|problem|concern|challenge)",
        "charge (more|higher)",
        "undercharg(e|ing|ed)",
        "too cheap",
        "pass(ing)? (on )?(the )?(cost|increase)",
        "afraid to (raise|increase|put up).{0,20}price[s]?",
        "can'?t (raise|increase|put up).{0,20}price[s]?",
        "margin (compression|squeeze|squeezed)",
        "communicat.{0,30}price",
        "not charging enough",
        "prices? (are )?too low",
        "under.?pric(ed|ing)",
        "reluctant to (raise|increase|put up).{0,20}price"
      ]
    },
    "cash_flow_gap": {
      "description": "Cash flow problems, working capital issues, or inability to pay bills",
      "domains": ["profit", "forecasting"],
      "patterns": [
        "cash.?flow",
        "running out of cash",
        "run(ning)? out of money",
        "going to run out of money",
        "gonna run out of money",
        "overdraft",
        "late (payment|payer|invoices?)",
        "debtor[s]?",
        "working capital",
        "can'?t pay.{0,20}(bills?|wages?|staff)",
        "cash.?(tight|squeeze|crunch|crisis)",
        "owed money",
        "collecting (payments?|invoices?|debts?)",
        "liquidity",
        "money going out (faster|quicker|more) than (it'?s? )?(coming in|income)",
        "cash (is )?(tight|short)",
        "tight on cash",
        "struggling to pay",
        "behind on (payments?|bills?|invoices?)",
        "can'?t (afford|cover).{0,20}(bills?|wages?|staff|costs?|rent)"
      ]
    },
    "revenue_modelling": {
      "description": "Advisor wants to build a revenue or feasibility model for a client's specific situation — includes the case where the client doesn't understand their cost base / true costs (a costing model answers it)",
      "domains": ["profit", "forecasting"],
      "patterns": [
        "build (a |the )?model",
        "revenue model",
        "feasibility (model|study|analysis)?",
        "model (out |their |the )?(revenue|numbers?|business|financials?)",
        "model(ling|ing)? (their |the )?(business|numbers?|revenue|financials?)",
        "industry model",
        "financial model",
        "what (the |their )?numbers (look|might|could|would) look like",
        "run (the |some |their )?numbers",
        "put (the |their )?numbers (together|in|into) (a )?model",
        "(don'?t|doesn'?t|do not) (really )?understand (the |their )?(numbers|costs?|costings?)",
        "(don'?t|doesn'?t|do not) know (the |their |what )?(it )?costs?",
        "poor costings?",
        "cost drivers?",
        "what it (actually |really )?costs? (them|to operate|to run)",
        "(true|real|actual|underlying) costs?",
        "(understand|know) (the |their )?(true |real )?cost (base|structure)"
      ]
    },
    "modeling_rejected": {
      "description": "Advisor explicitly indicated revenue modelling is not the solution. Penalty-only signal — no positive template matching.",
      "domains": [],
      "penaltyOnly": true,
      "patterns": [
        "don'?t need (a |the )?model",
        "already have (a |the )?model",
        "not about (the )?model(ling|ing)?",
        "not (really )?(a |about )?financial (issue|problem|challenge)",
        "operational (problem|issue|challenge)",
        "wouldn'?t (want|need|benefit from) (a )?model",
        "not at the stage",
        "just (keep|focus|need to focus)",
        "focus on (getting more |the )?sales"
      ]
    },
    "staff_problem": {
      "description": "Staff, team, HR, or leadership issues",
      "domains": ["staff"],
      "patterns": [
        "staff (issue|problem|challenge|leaving|turnover|performance|morale)",
        "team (issue|problem|challenge|morale|performance|culture)",
        "employee (problem|issue|leaving|performance|dissatisfied)",
        "culture (problem|issue|toxic)",
        "poor (staff |team )?performance",
        "hiring (problem|challenge|issue|difficulty)",
        "retain(ing)? (staff|team|employees?|people)",
        "people problem",
        "leadership (issue|problem|gap)",
        "can'?t (find|hire|keep|retain) (good )?(staff|people)",
        "people (issues?|problems?)",
        "short.?staffed|under.?staffed",
        "morale (is )?(low|down|poor)",
        "team (isn'?t|is not|not) (performing|working|gelling)"
      ]
    },
    "strategy_needed": {
      "description": "Strategic direction, planning, or pivot required",
      "domains": ["strategy"],
      "patterns": [
        "strategic (direction|plan(ning)?|review|pivot)",
        "no (clear |strategic )?direction",
        "where (to go|the business is going)",
        "pivot(ing)?",
        "new (direction|market|product|service|strategy)",
        "lost direction",
        "long.?term (plan|strategy|direction)",
        "growth (plan|strategy|direction)",
        "need(s)? (a )?(clear )?strategy",
        "no (clear )?plan",
        "business (is )?(stuck|stagnant|plateaued|treading water)"
      ]
    },
    "data_quality": {
      "description": "Data integrity, chart of accounts, or financial systems accuracy issues",
      "domains": ["data-systems"],
      "patterns": [
        "data (is|are|was|were) (wrong|bad|messy|dirty|inaccurate|unreliable)",
        "rubbish in",
        "chart of accounts",
        "messy (books?|data|accounts?|records?)",
        "incorrect (data|reports?|figures?|numbers?)",
        "can'?t trust (the )?(data|numbers?|figures?|reports?)",
        "accounts? (in a mess|messy|wrong|incorrect)",
        "data (issue|problem)",
        "numbers (don'?t|do not|aren'?t) (add up|right|reliable|accurate)",
        "reporting (is )?(poor|weak|unreliable|wrong|a mess)",
        "bad (data|numbers)"
      ]
    },
    "governance_gap": {
      "description": "Governance structure, accountability, or board issues",
      "domains": ["governance"],
      "patterns": [
        "governance (gap|issue|problem|lacking|needed)",
        "no (governance|board structure|accountability)",
        "(needs?|wants?) (a |more )?governance",
        "accountability (issue|problem|gap)",
        "board (structure|function|needed|required)",
        "decision.?making (problem|issue|poor|slow)",
        "partners? (disagree|fall(ing)? out|at odds|not aligned|don'?t agree)",
        "no (clear )?(controls?|oversight)",
        "decisions? (take|taking).{0,15}(too long|forever|ages)"
      ]
    },
    "governance_too_early": {
      "description": "Business is not yet ready for governance — ineffective foundational management (no clear objectives, failure accepted as normal, no honest feedback). Too Early For Governance.",
      "domains": ["governance"],
      "patterns": [
        "no (clear|measurable) (business )?objectives",
        "(don'?t|do not|doesn'?t) (have|set|track) .{0,20}objectives",
        "accept(s|ing)? (task )?fail(ure)?",
        "fail(ure|ing)? (is )?(seen as |treated as )?(normal|accepted|tolerated|expected)",
        "(hides?|hiding|hidden|bur(y|ies|ied)|covers?|covered) .{0,12}mistakes",
        "mistakes (are |get )?(hidden|buried|covered|swept)",
        "no (honest )?feedback",
        "(blame|fear) culture",
        "too early for governance",
        "not ready for governance",
        "(ineffective|weak|poor) (foundational )?management"
      ]
    },
    "succession_issue": {
      "description": "Succession planning, exit, or ownership transition",
      "domains": ["succession"],
      "patterns": [
        "succession",
        "exit(ing)? (the business|plan|strategy)?",
        "handover",
        "pass(ing)? (it|the business) on",
        "retir(e|ing|ement)",
        "next generation",
        "sell(ing)? (the )?business",
        "step(ping)? back from the business",
        "wind(ing)? down",
        "no (successor|one to take over)",
        "who('?ll| will| is going to) (take over|run (it|the business))",
        "plan(ning)? (my|their|his|her|the) exit"
      ]
    },
    "systems_gap": {
      "description": "Business systems, process, or technology gaps",
      "domains": ["systems", "data-systems"],
      "patterns": [
        "process(es)? (issue|problem|broken|inefficient)",
        "system[s]? (issue|problem|needed|outdated|not working)",
        "technolog(y|ical) (issue|problem|gap|needed)",
        "manual (process|work|admin)",
        "inefficient (process|workflow|admin)",
        "automat(e|ion|ing) (tasks?|processes?|workflows?)",
        "workflow (issue|problem|broken)",
        "everything('?s| is)? manual",
        "(doing (it|everything)) by hand",
        "processes? (are )?(a mess|messy|broken|undefined)",
        "no (proper )?(systems?|processes?)"
      ]
    },
    "marketing_gap": {
      "description": "Marketing, brand awareness, or digital presence gaps",
      "domains": ["sales-marketing"],
      "patterns": [
        "marketing (issue|problem|needed|gap|not working)",
        "no marketing",
        "brand (awareness|recognition|issue|problem)",
        "digital (marketing|presence|strategy)",
        "online (presence|marketing|visibility)",
        "not (visible|known|getting found)",
        "awareness (issue|problem|gap|low)",
        "marketing (isn'?t|is not|not) working",
        "no (online|social|web|digital) presence",
        "poor (brand|positioning)",
        "no ?(one|body) (knows|has heard of) (us|them|the business)"
      ]
    },
    "stock_management": {
      "description": "Stock/inventory management problems — overstocking, stockouts, slow stock turn, high days on hand, supply chain disruption",
      "domains": ["stock-purchasing"],
      "patterns": [
        "not turning (stock|inventory) over",
        "stock (isn'?t|is not|not) turning over",
        "(slow|poor|low) stock turn(over)?",
        "stock turn(over)? (is )?(slow|poor|low|down)",
        "(too many|high|excess) days on hand",
        "days on hand (is|are) (too )?high",
        "too much (stock|inventory)",
        "over.?stock(ed|ing)?",
        "excess (stock|inventory)",
        "stock (sitting|piling up|gathering dust)",
        "(money|cash|capital) tied up in (stock|inventory)",
        "running out of (stock|inventory)",
        "stock.?outs?",
        "out of stock",
        "can'?t keep (stock|product|shelves) (stocked|full|on the shelf)",
        "supply chain (disruption|issues?|problems?|delays?|shortages?)",
        "suppl(y|ier) (disruption|issues?|problems?|delays?|shortages?)",
        "dead stock",
        "obsolete (stock|inventory)",
        "stock (wastage|spoilage|write.?offs?)",
        "reorder(ing)? (issue|problem|too late|too much|too little)",
        "ordering (too much|too little|the wrong)",
        "(stock|inventory) (management|control) (issue|problem|poor|a mess)"
      ]
    },
    "capital_raising": {
      "description": "Raising capital or funding an acquisition — needs investment to grow, seeking investors, undercapitalised, can't self-fund, funding a purchase",
      "domains": ["raising-capital"],
      "patterns": [
        "raise (money|capital|funds?|finance|equity)",
        "raising (money|capital|funds?|finance|equity)",
        "need(s)? (to raise |more )?(capital|funding|finance|investment)",
        "need (money|funding|finance|capital) to grow",
        "can'?t self.?fund",
        "(can'?t|unable to|struggling to) fund (their|its|the) (growth|expansion)",
        "looking for (an? )?investors?",
        "(seeking|find|attract|bring in) (an? )?investors?",
        "pitch(ing)? (to )?(investors?|VCs?|venture)",
        "pitch deck",
        "venture capital",
        "equity (funding|raise|investment)",
        "term sheet",
        "capital raise",
        "under.?capitalis(ed|ation)",
        "under.?funded",
        "(don'?t|doesn'?t|do not) (know|understand) (their )?cost of capital",
        "capital structure (issue|problem|review|advice)",
        "working capital review",
        "(raise|raising) (money|capital|finance|funds?) to (buy|acquire)",
        "fund(ing)? (an?|the )?acquisition",
        "money to (buy|acquire) (a|another|the) (business|competitor|company|rival)"
      ]
    }
  }
}
