        "sales-marketing",
        "profit"
      ],
      "patterns": [
        "foot.?traffic",
        "not enough (customers?|clients?|people|visitors?)",
        "sales (are|is|were|was) (down|slow|low|poor|flat|weak)",
        "slow (sales|business|trade)",
        "(low|poor|bad|poor) conversion",
        "not (getting|converting|attracting) (enough )?(leads?|inquiries|customers?|business)",
        "lack of demand",
        "losing customers?",
        "customer numbers?",
        "need (more )?customers?",
        "grow(ing)? (the )?(customer|client) base",
        "attract (more )?(customers?|clients?|people)",
        "build (a )?(client|customer) base",
        "more (customers?|clients?|sales|business)",
        "not enough (foot|walk.in|walk in) traffic",
        "run(ning)? out of (customers?|clients?|people)",
        "not upselling",
        "upsell(ing)?.*not happening",
        "no upsell",
        "upsell(ing)?",
        "cross.?sell(ing)?",
        "sell(ing)? more",
        "increase (their )?(average )?(spend|transaction|basket|order value)",
        "sales (issue|problem|trouble|struggle|struggling)",
        "struggling (to|with) (sell|sales)",
        "(low|declining|dropping|falling) sales",
        "can'?t (win|land|close|get) (new )?(clients?|customers?|work|business)",
        "few (prospects?|leads?|enquiries|inquiries)"
