#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# nvm-windows: NVM_SYMLINK holds the active node path as a Windows path — convert it for bash
[ -n "$NVM_SYMLINK" ] && export PATH="$(cygpath -u "$NVM_SYMLINK"):$PATH"

npm run lint

npm test

# Audit at critical level only — high-severity vulnerabilities are risk-accepted
# in SECURITY-AUDIT-NOTES.md (locked to Nuxt 2 dependency tree, build tools only).
NODE_EXTRA_CA_CERTS=./certs/digicert-bundle.pem npm audit --audit-level=critical
