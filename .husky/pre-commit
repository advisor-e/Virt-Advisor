#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# nvm-windows: NVM_SYMLINK holds the active node path as a Windows path — convert it for bash
[ -n "$NVM_SYMLINK" ] && export PATH="$(cygpath -u "$NVM_SYMLINK"):$PATH"

# Gate 0, and it runs FIRST for a reason: the gate below reads the working tree, not
# the index. If those differ, its green tick describes code that is not being committed
# (see `hook-tests-worktree-not-commit` in design/ACTIONS.md).
node scripts/check-staged-tree.js

# The quick gate — sized to the commit (Mike, 2026-09-03). Lint on the staged files and
# the tests that reach them, coverage off. Until today this hook ran full lint, the full
# suite WITH coverage and the audit gate on every commit: eight minutes on the desktop,
# five times a day. Those three now run ONCE, in .husky/pre-push, before anything leaves
# the machine. Nothing reaches master tested less than before; a local commit that turns
# out red at push is fixed forward.
node scripts/quick-gate.js
