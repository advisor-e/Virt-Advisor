# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Test coverage reports (generated by jest --coverage)
coverage

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Claude Code — ignore local state, but DO share project skills and commands.
# `commands/` MUST stay shared: /startup and /shutdown are the Working Agreement
# checklists, and they are worthless if only one machine has them.
.claude/*
!.claude/skills/
!.claude/commands/

# Generated search exports (not for version control)
search_content_*.json

# EXCEPTION — Collaborate's template-catalogue snapshot IS version-controlled.
# It arrived tracked in the Collaborate repo (advisor-e/Colab) and its 17 marketplace
# tests cannot run without it. The pattern above has no folder anchor, so without this
# line the file would be invisible to git anywhere in the repo: green on the machine
# that copied it in, missing on the other machine and in CI.
!data/collaborate/search_content_20260625201604.json

