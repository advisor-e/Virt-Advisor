# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Test coverage reports (generated by jest --coverage)
coverage

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Claude Code — ignore local state, but DO share project skills and commands.
# `commands/` MUST stay shared: /startup and /shutdown are the Working Agreement
# checklists, and they are worthless if only one machine has them.
.claude/*
!.claude/skills/
!.claude/commands/

# Generated search exports (not for version control)
search_content_*.json

# EXCEPTION — Collaborate's template-catalogue snapshot IS version-controlled.
# It arrived tracked in the Collaborate repo (advisor-e/Colab) and its 17 marketplace
# tests cannot run without it. The pattern above has no folder anchor, so without this
# line the file would be invisible to git anywhere in the repo: green on the machine
# that copied it in, missing on the other machine and in CI.
!data/collaborate/search_content_20260625201604.json

# Dev-only firm distinctions (created locally when MySQL is unavailable)
data/dev-firm-distinctions.json
data/dev-firm-distinction-declines.json
data/dev-firm-distinction-overrides.json
data/dev-firm-distinction-lastseen.json
data/dev-firm-distinction-override-baselines.json
data/dev-firm-currency.json

# Dev-only platform (mentor) distinctions (created locally when MySQL is unavailable)
data/dev-platform-distinctions.json

# Dev-only property tax rules (created locally when MySQL is unavailable). Keyed by
# SCOPE rather than by firm — one file holds the group's, the firm's and the platform's
# local changes together — so leaking it would put one machine's whole tier chain into
# the repo, not one firm's row.
data/dev-property-tax-rules.json

# Dev-only AI prompt settings. Keyed by SCOPE for the same reason as the tax rules
# above, and ignored for the same reason.
data/dev-ai-prompts.json

# Dev-only firm staircase override (created locally when MySQL is unavailable)
data/dev-firm-staircase.json
# The four cascade keys, added when the staircase joined the one firm-editable
# mechanism (2026-07-31). Every sibling above is ignored for the same reason:
# these hold one firm's dev configuration and must never reach the repo.
data/dev-firm-staircase-declines.json
data/dev-firm-staircase-overrides.json
data/dev-firm-staircase-own.json
data/dev-firm-staircase-override-baselines.json

# Dev-only firm template import (created locally when MySQL is unavailable)
data/dev-firm-templates.json
data/dev-firm-coaching.json

# Item 4.31 step 4 - a level's own prompt material and the offers it has accepted.
# Same reason as dev-firm-coaching.json above: a firm's own words about how it works.
data/dev-prompt-contributions.json
# The coaching reference's per-entry decisions (2026-08-15, item 4.9). Listed WITH the
# config keys that create them, per the rule at the quiz block below. NOT the same file
# as dev-firm-coaching.json above, which holds PROMOTED CASE OBSERVATIONS — a firm's
# advisors' own free text, which reaches the model fenced and is never inherited.
data/dev-firm-coaching-declines.json
data/dev-firm-coaching-overrides.json
data/dev-firm-coaching-own.json

# Dev-only firm quiz overlay (created locally when MySQL is unavailable)
data/dev-firm-quizzes.json
# The mechanism's per-question decisions (2026-07-31). Listed WITH the config keys
# that create them: a new storage key needs a new ignore line, and that was missed
# twice running before the staircase near-miss made the pattern explicit.
data/dev-firm-quiz-declines.json
data/dev-firm-quiz-overrides.json
data/dev-firm-quiz-own.json
# Phase 4 drift baselines (2026-08-01) — added with the key, per the rule above.
data/dev-firm-quiz-override-baselines.json

# Meeting Review's observation points — a level's per-scenario decisions (2026-09-01,
# slice 1). Listed WITH the three config keys that create them, per the rule at the quiz
# block above. Same reason as dev-firm-coaching.json: these are a firm's OWN words about
# how it runs a meeting — its house standard, not platform content — and a firm's standards
# have no business reaching this repository from a developer's laptop.
data/dev-meeting-observation-declines.json
data/dev-meeting-observation-overrides.json
data/dev-meeting-observation-own.json
data/dev-meeting-type-declines.json
data/dev-meeting-type-overrides.json
data/dev-meeting-type-own.json
data/dev-meeting-type-order.json

# Meeting Review's retention dial (2026-09-01, slice 2) — how long ONE firm keeps its
# transcripts. Ignored for the same reason as the three above, and for one of its own: the
# figure is spoken aloud to that firm's clients, so it is a statement that firm makes, not a
# platform default to be carried around in the repository.
data/dev-meeting-retention.json

# Dev-only firm content overlays — domain support + logic trees (created locally when MySQL is unavailable)
data/dev-firm-domain-support.json
data/dev-firm-logic-trees.json
# Dev-only method-guide wording overlay (item 4.16 F) — keyed by GUIDE id, because
# three of the thirteen are shown on two domain pages and must not diverge between them.
data/dev-firm-method-guides.json
# Dev-only firm section placement overlays (firm re-filing, display-only)
data/dev-firm-logic-tree-sections.json
data/dev-firm-domain-support-sections.json

# Dev-only Logic-Lab accepted-idea log (the mentor-rollup feed, written locally
# when MySQL is unavailable)
data/dev-firm-logic-lab-accepted.json

# Dev-only case studies (created locally when MySQL is unavailable)
data/dev-cases.json

# Dev-only client register (created locally when MySQL is unavailable)
data/dev-clients.json

# Dev-only courses (created locally when MySQL is unavailable)
data/dev-courses.json

# Dev-only advisor activity — VA sessions and course completions
# (created locally when MySQL is unavailable)
data/dev-activity.json

# Dev-only Collaborate people store — advisers, groups, threads, postures
# (created locally so the Adviser Network tab survives a restart; NEVER written
# in production, where MySQL is the store — see server/collaborate/data/devStore.js)
data/dev-collaborate-people.json

# Local CA cert bundle (machine-specific export from Windows cert store)
certs/

# Visual-check screenshots (npm run visual). Pictures of the screens as they
# rendered, for a person to look at -- regenerated on every run, never kept.
visual-screenshots/
